manifest {
    name            = 'OrganelleFix'
    author          = 'Mateusz Mazdziarz'
    description     = 'A Nextflow pipeline for organellar genome analysis.'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.4'
}

params {
    samples_table            = null
    outdir                   = "results"
    threads_prepare_genome   = 2
}

profiles {
    standard {
        docker.enabled = true
        docker.fixOwnership = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
    }
}

process {
    container = 'mordziarz/organelle_pipeline:latest'
    
    withName: 'PREPARE_GENOME' {
        cpus = { params.threads_prepare_genome }
        publishDir = [
            path: { "${params.outdir}/prepared_genomes/${meta.sample_id}" },
            mode: 'copy'
        ]
    }
}
